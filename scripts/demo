#!/usr/bin/env bash
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
mode="${1:-help}"
if [[ $# -gt 0 ]]; then shift; fi
case "$mode" in
  spring) module="spring-agent" ;;
  koog) module="koog-agent" ;;
  live) module="live-lab" ;;
  *)
    echo "Usage: scripts/demo spring|koog step0|step1|step2|step3|step4|step5 [question]   # лестница, docs/ladder.md"
    echo "       scripts/demo live [status|metrics|logs|database|restart] [service] | terminate <pid>   # COMPACT=true — компактные ответы"
    exit 0 ;;
esac
launcher="$project_dir/$module/build/install/$module/bin/$module"
if [[ ! -x "$launcher" ]]; then
  echo "Build the launchers first: ./gradlew installDist" >&2
  exit 1
fi
export SHERLOCK_PROJECT_DIR="$project_dir"
exec "$launcher" "$@"
