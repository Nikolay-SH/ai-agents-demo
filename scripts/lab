#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
compose() { docker compose --project-name sherlock-live --file "$ROOT/compose.yaml" "$@"; }
case "${1:-help}" in
  up)
    ./gradlew :demo-services:bootJar --console=plain
    # Direct build also works around Compose Bake session headers on non-ASCII paths.
    docker build --tag sherlock-live-demo:0.1.0 --file docker/Dockerfile "$ROOT"
    compose up --no-build --detach
    echo 'Checkout: http://localhost:18081/demo/status'
    echo 'Payment: http://localhost:18082/demo/status'
    echo 'Grafana: http://localhost:13000/d/sherlock-live'
    ;;
  status)
    compose ps
    for port in 18081 18082; do
      curl --fail --silent --show-error --max-time 5 "http://127.0.0.1:$port/demo/status" || true
      echo
    done
    ;;
  fault)
    case "${2:-}" in
      close-pool)
        curl --fail --silent --show-error --max-time 5 --request POST http://127.0.0.1:18082/demo/faults/close-pool
        echo ;;
      lock)
        # Reporting job takes a consistent snapshot: SHARE lock blocks INSERT, allows SELECT. Released after 15 min or by reset.
        compose exec -d -T -e PGAPPNAME=reporting-job payments-db sh -c \
          '(echo "BEGIN; LOCK TABLE payments IN SHARE MODE;"; sleep 900) | psql -U sherlock -d sherlock'
        echo 'reporting-job holds SHARE lock on table payments (idle in transaction)' ;;
      *) echo 'Usage: scripts/lab fault close-pool|lock' >&2; exit 2 ;;
    esac
    ;;
  reset)
    # Manual operator reset. Agent-triggered actions use the separate approval boundary.
    # Ending `sleep` closes psql stdin: the reporting-job transaction rolls back and releases the lock.
    compose exec -T payments-db sh -c "pkill -f 'sleep 900' || true"
    compose restart payment checkout
    ;;
  down)
    # Keep PostgreSQL volume; never target another Compose project.
    compose down
    ;;
  *)
    echo 'Usage: scripts/lab {up|status|fault close-pool|fault lock|reset|down}'
    echo 'down preserves PostgreSQL data; reset is a manual operator action.'
    [[ "${1:-help}" == help ]]
    ;;
esac
